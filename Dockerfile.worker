# EasyFlow — worker (BullMQ DM sender + comment-polling reconciler)
# Long-running process, cannot run on serverless. Runs the TS source
# directly via tsx, so it needs the full node_modules (unlike the web
# image's pruned standalone build) and a generated Prisma client.

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run db:generate

CMD ["npm", "run", "worker"]
